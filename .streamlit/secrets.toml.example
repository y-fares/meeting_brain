# Copier ce fichier en secrets.toml et remplir les valeurs
# NE JAMAIS committer secrets.toml sur GitHub

# Fournisseur actif : groq | mistral | gemini (auto-détecté si vide)
LLM_PROVIDER = "mistral"

# Groq
GROQ_API_KEY = ""
GROQ_MODEL = "llama-3.1-8b-instant"

# Mistral (recommandé)
MISTRAL_API_KEY = "..."
MISTRAL_MODEL = "mistral-small-latest"

# Gemini
GOOGLE_API_KEY = ""
GEMINI_MODEL = "gemini-pro"

# Optionnel — Notion
NOTION_API_KEY = ""
NOTION_DATABASE_ID = ""

# Optionnel — Slack
SLACK_SIGNING_SECRET = ""
